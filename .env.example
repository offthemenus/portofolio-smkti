# Contoh konfigurasi database. JANGAN isi kredensial asli di sini.
#
# Pilih SALAH SATU cara:
#
# Cara 1 — environment variable (disarankan untuk server/Vercel):
#   DB_HOST=nama-host-mysql
#   DB_PORT=3306
#   DB_NAME=nama_database
#   DB_USER=nama_user
#   DB_PASS=password_asli
#
# Cara 2 — file lokal (paling mudah untuk Laragon & InfinityFree):
#   Salin contoh di bawah ke file: config/config.local.php
#   File itu TIDAK masuk repo (ada di .gitignore), jadi aman.
#
# <?php
# return [
#     'DB_HOST' => '127.0.0.1',   // lokal Laragon; di InfinityFree pakai host dari panel
#     'DB_PORT' => '3306',
#     'DB_NAME' => 'portofolio',
#     'DB_USER' => 'root',
#     'DB_PASS' => '',
# ];
